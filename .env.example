# 個人情報のキー一覧。
#
# 値そのものはリポジトリに入れない。
#   ローカル … このファイルを .env.local としてコピーし、値を埋める
#   本番     … Vercel の Project Settings > Environment Variables に同じキーを設定
#
# NEXT_PUBLIC_ は付けないこと。サーバーコンポーネントでのみ読み、
# 静的生成時に HTML へ焼き込む。

PROFILE_FULL_NAME=
PROFILE_FULL_NAME_EN=
# 氏名の別表記。カンマ区切り（例: 異体字で書いた氏名）
PROFILE_FULL_NAME_ALIASES=
PROFILE_AFFILIATION=
PROFILE_GRADE=
PROFILE_TITLE=

CLUB_NAME=
CLUB_PERIOD=
CLUB_DETAIL=
